<mvc:View
    controllerName="com.john.employeeapp.com.john.employeeapp.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">


<Page>


    <customHeader>


        <OverflowToolbar>


            <Title
                text="Danglose Law Office"
                titleStyle="H3"/>


            <ToolbarSpacer/>


            <Button
                icon="sap-icon://home"
                text="Home"
                press="onHome"
                type="Transparent"/>


            <Button
                icon="sap-icon://official-service"
                text="About"
                press="onAbout"
                type="Transparent"/>


            <Button
                icon="sap-icon://customer-view"
                text="Services"
                press="onServices"
                type="Transparent"/>


            <Button
                icon="sap-icon://employee"
                text="Attorney"
                press="onAttorney"
                type="Transparent"/>


            <Button
                icon="sap-icon://email"
                text="Contact"
                press="onContact"
                type="Transparent"/>


        </OverflowToolbar>


    </customHeader>


    <content>


        <App
            id="app"/>


    </content>


</Page>


</mvc:View>
<mvc:View
    controllerName="com.john.employeeapp.com.john.employeeapp.controller.Services"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">


    <Page
        title="Legal Services">

        <content>

            <VBox
                class="sapUiLargeMargin">


                <Title
                    text="Our Legal Services"
                    level="H1" />


                <Text
                    text="Providing professional legal and notarial assistance tailored to your needs."
                    wrapping="true"
                    class="sapUiSmallMarginBottom" />


                <VBox
                    items="{services>/services}">


                    <Panel
                        class="sapUiSmallMarginBottom">


                        <content>

                            <HBox
                                alignItems="Start"
                                wrap="Wrap">


                                <core:Icon
                                    src="{services>icon}"
                                    size="2rem"
                                    class="sapUiSmallMarginEnd" />


                                <VBox>


                                    <Title
                                        text="{services>title}"
                                        level="H3" 
                                        wrapping="true"/>


                                    <Text
                                        text="{services>description}"
                                        wrapping="true" />


                                    <Button
                                        text="Learn More"
                                        type="Emphasized"
                                        class="sapUiSmallMarginTop"
                                        press="onLearnMore" />


                                </VBox>


                            </HBox>


                        </content>


                    </Panel>


                </VBox>


            </VBox>


        </content>


    </Page>


</mvc:View>
<mvc:View
    controllerName="com.john.employeeapp.com.john.employeeapp.controller.Attorney"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        title="Attorney Profile">


        <content>


            <VBox
                width="100%"
                alignItems="Center">


                <VBox
                    width="90%"
                    class="sapUiLargeMargin">


                    <!-- Attorney Header -->

                    <VBox
                        alignItems="Center">


                        <Avatar
                            src="{attorney>/photo}"
                            displaySize="XL"
                            displayShape="Circle"/>


                        <Title
                            text="{attorney>/name}"
                            level="H1"
                            class="sapUiMediumMarginTop"
                            wrapping="true"
                            textAlign="Center"/>


                        <Text
                            text="{attorney>/title}"
                            wrapping="true"
                            textAlign="Center"/>

                        <HBox
                            class="sapUiMediumMarginTop"
                            justifyContent="Center"
                            wrap="Wrap">


                            <Button
                                text="{attorney>/phone}"
                                icon="sap-icon://call"/>


                            <Button
                                text="{attorney>/email}"
                                icon="sap-icon://email"
                                
                                class="sapUiSmallMarginBegin"/>


                        </HBox>


                    </VBox>




                    <!-- Professional Profile -->

                    <Panel
                        headerText="Professional Profile"
                        class="sapUiMediumMarginTop">


                        <content>


                            <Text
                                text="{attorney>/description}"
                                wrapping="true"/>


                        </content>


                    </Panel>




                    <!-- Practice Areas -->


                    <Panel
                        headerText="Practice Areas"
                        class="sapUiMediumMarginTop">


                        <content>


                            <List
                                items="{attorney>/practiceAreas}">


                                <CustomListItem>


                                    <VBox
                                        class="sapUiSmallMargin">


                                        <HBox
                                            alignItems="Center">


                                            <core:Icon
                                                src="{attorney>icon}"
                                                size="1.5rem"/>


                                            <Title
                                                text="{attorney>name}"
                                                level="H4"
                                                class="sapUiSmallMarginBegin"
                                                wrapping="true"/>


                                        </HBox>


                                        <Text
                                            text="{attorney>description}"
                                            wrapping="true"
                                            class="sapUiSmallMarginTop"/>


                                    </VBox>


                                </CustomListItem>


                            </List>


                        </content>


                    </Panel>


                </VBox>


            </VBox>


        </content>


    </Page>


</mvc:View>
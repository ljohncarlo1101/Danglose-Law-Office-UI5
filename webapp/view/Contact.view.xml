<mvc:View
    controllerName="com.john.employeeapp.com.john.employeeapp.controller.Contact"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">


    <Page
        title="Book a Consultation">


        <content>


            <VBox
                class="sapUiLargeMargin">


                <Title
                    text="Book a Consultation"
                    level="H1"/>


                <Text
                    text="Please provide your information and legal concern. Our office will get back to you as soon as possible."
                    wrapping="true"
                    class="sapUiSmallMarginBottom"/>




                <!-- Full Name -->

                <Label
                    text="Full Name"
                    required="true"/>


                <Input
                    id="nameInput"
                    placeholder="Enter your full name"/>




                <!-- Email -->

                <Label
                    text="Email Address"
                    required="true"
                    class="sapUiSmallMarginTop"/>


                <Input
                    id="emailInput"
                    type="Email"
                    placeholder="Enter your email address"/>





                <!-- Contact Number -->

                <Label
                    text="Contact Number"
                    required="true"
                    class="sapUiSmallMarginTop"/>


                <Input
                    id="phoneInput"
                    placeholder="09XXXXXXXXX"/>






                <!-- Service Selection -->

                <Label
                    text="Legal Service"
                    required="true"
                    class="sapUiSmallMarginTop"/>


                <Select
                    id="serviceSelect"
                    items="{services>/services}">


                    <items>


                        <core:Item
                            xmlns:core="sap.ui.core"
                            key="{services>id}"
                            text="{services>title}"/>


                    </items>


                </Select>






                <!-- Message -->

                <Label
                    text="Describe Your Concern"
                    required="true"
                    class="sapUiSmallMarginTop"/>


                <TextArea
                    id="messageInput"
                    rows="5"
                    placeholder="Briefly describe your legal concern"/>






                <!-- Preferred Contact -->

                <Label
                    text="Preferred Contact Method"
                    class="sapUiSmallMarginTop"/>


                <RadioButtonGroup
                    id="contactMethod">


                    <buttons>


                        <RadioButton
                            text="Email"/>


                        <RadioButton
                            text="Phone Call"/>


                        <RadioButton
                            text="Office Visit"/>


                    </buttons>


                </RadioButtonGroup>







                <!-- Submit -->

                <Button
                    text="Submit Consultation Request"
                    type="Emphasized"
                    icon="sap-icon://paper-plane"
                    press="onSubmit"
                    class="sapUiMediumMarginTop"/>



            </VBox>


        </content>


    </Page>


</mvc:View>
<mvc:View

    controllerName="com.john.employeeapp.com.john.employeeapp.controller.About"

    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">


    <Page
        title="About Us">


        <content>


            <VBox
                class="sapUiLargeMargin">


                <Title
                    text="{about>/officeName}"
                    level="H1"
                    wrapping="true"/>


                <Text
                    text="{about>/description}"
                    wrapping="true"
                    class="sapUiSmallMarginTop"/>



                <!-- Office Hours -->

                <Panel
                    headerText="Office Hours"
                    class="sapUiMediumMarginTop">


                    <content>


                        <VBox>


                            <HBox>

                                <core:Icon
                                    src="sap-icon://time-entry-request"
                                    size="1.5rem"
                                    class="sapUiSmallMarginEnd"/>


                                <Text
                                    text="{about>/officeHours/weekday}"
                                    wrapping="true"/>


                            </HBox>



                            <HBox
                                class="sapUiSmallMarginTop">


                                <core:Icon
                                    src="sap-icon://appointment-2"
                                    size="1.5rem"
                                    class="sapUiSmallMarginEnd"/>


                                <Text
                                    text="{about>/officeHours/weekend}"
                                    wrapping="true"/>


                            </HBox>


                        </VBox>


                    </content>


                </Panel>




                <!-- Office Address -->


                <Panel
                    headerText="Office Address"
                    class="sapUiMediumMarginTop">


                    <content>


                        <VBox>


                            <HBox>


                                <core:Icon
                                    src="sap-icon://map"
                                    size="1.5rem"
                                    class="sapUiSmallMarginEnd"/>


                                <Text
                                    text="{about>/address/street}"
                                    wrapping="true"/>


                            </HBox>

                        </VBox>


                    </content>


                </Panel>




                <!-- Google Map -->


                <Panel

                    headerText="Office Location"

                    class="sapUiMediumMarginTop">


                    <content>


                        <core:HTML

                            content="{about>/mapEmbed}"/>


                    </content>


                </Panel>



            </VBox>


        </content>


    </Page>


</mvc:View>